{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TypingBot",
  "version": "2.0.0",
  "identifier": "app.typingbot.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "TypingBot",
        "width": 440,
        "height": 680,
        "resizable": false,
        "center": false,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Local writing-process playback",
    "longDescription": "Build and play transparent planning, drafting, and polishing demonstrations in any desktop text field.",
    "copyright": "Copyright 2026 Euler2718e",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
